<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension translationdomain="cutscape" xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Remove Preview</name>
  <id>io.github.jetpax.cutscape.clear</id>
  <param name="entry" type="string" gui-hidden="true">clear</param>
  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <icon>cutscape_cut.svg</icon>
    <menu-tip>Remove the CutScape toolpath preview from the drawing</menu-tip>
    <effects-menu>
      <submenu name="CutScape"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">cutscape_cut.py</command>
  </script>
</inkscape-extension>
