<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension translationdomain="cutscape" xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Printer Queue</name>
  <id>io.github.jetpax.cutscape.queue</id>
  <param name="action" type="string" gui-hidden="true">printers</param>
  <label>Sets up the CUPS printer queue CutScape sends to, for a cutter connected by USB.</label>
  <param name="printer_task" type="optiongroup" appearance="radio" gui-text="Action:">
    <option value="create">Create the queue for the USB cutter</option>
    <option value="restart">Restart the queue and clear stuck jobs</option>
    <option value="remove">Remove the queue</option>
  </param>
  <param name="printer" type="string" gui-text="Queue name:" gui-description="Enter the same name under Printer queue on the Connection tab of Cut">cutter</param>
  <param name="printer_uri" type="string" gui-text="Cutter's USB address:" gui-description="Only needed when more than one USB printer has no queue. Find Connected Cutters lists the addresses (usb://…)"></param>
  <separator/>
  <label>Changing printers needs CUPS admin rights. If CUPS refuses, CutScape shows the sudo command to run instead.</label>
  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <icon>cutscape_cut.svg</icon>
    <menu-tip>Create, restart or remove the printer queue for a USB cutter</menu-tip>
    <effects-menu>
      <submenu name="CutScape"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">cutscape_cut.py</command>
  </script>
</inkscape-extension>
