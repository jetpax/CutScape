<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension translationdomain="cutscape" xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Find Connected Cutters</name>
  <id>io.github.jetpax.cutscape.find</id>
  <!-- No visible parameters, so Inkscape runs it straight away -->
  <param name="action" type="string" gui-hidden="true">find</param>
  <effect needs-live-preview="false">
    <object-type>all</object-type>
    <icon>cutscape_cut.svg</icon>
    <menu-tip>List the cutters, printer queues and serial ports CutScape can send to</menu-tip>
    <effects-menu>
      <submenu name="CutScape"/>
    </effects-menu>
  </effect>
  <script>
    <command location="inx" interpreter="python">cutscape_cut.py</command>
  </script>
</inkscape-extension>
