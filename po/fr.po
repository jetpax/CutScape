#: extension/cutscape_cut.inx
#: extension/cutscape_cut.inx
msgid "Cut"
msgstr "Découpe"

#: extension/cutscape_cut.inx
msgid "Apply will:"
msgstr "Le bouton Appliquer :"

#: extension/cutscape_cut.inx
msgid "Preview the toolpath on the canvas"
msgstr "prévisualise le tracé de coupe sur le canevas"

#: extension/cutscape_cut.inx
msgid "Send to the cutter"
msgstr "envoie à la découpeuse"

#: extension/cutscape_cut.inx
msgid "Send a 50 mm test square"
msgstr "envoie un carré test de 50 mm"

#: extension/cutscape_cut.inx
msgid "Find connected cutters"
msgstr "recherche les découpeuses connectées"

#: extension/cutscape_cut.inx
msgid "Manage the printer queue"
msgstr "gère la file d’impression"

#: extension/cutscape_cut.inx
msgid "Remove the preview"
msgstr "supprime l’aperçu"

#: extension/cutscape_cut.inx
msgid "Cuts the selection, or the whole drawing if nothing is selected."
msgstr "Découpe la sélection, ou tout le dessin si rien n’est sélectionné."

#: extension/cutscape_cut.inx
msgid "Speed (cm/s):"
msgstr "Vitesse (cm/s) :"

#: extension/cutscape_cut.inx
#: extension/cutscape_cut.inx
msgid "0 leaves the cutter's own setting"
msgstr "0 conserve le réglage de la découpeuse"

#: extension/cutscape_cut.inx
msgid "Force (g):"
msgstr "Pression (g) :"

#: extension/cutscape_cut.inx
msgid "Passes:"
msgstr "Passages :"

#: extension/cutscape_cut.inx
msgid "Cut each path this many times; closed paths are cut as one continuous loop"
msgstr "Découpe chaque chemin ce nombre de fois ; les chemins fermés sont découpés en une seule boucle continue"

#: extension/cutscape_cut.inx
msgid "Overcut (mm):"
msgstr "Surcoupe (mm) :"

#: extension/cutscape_cut.inx
msgid "Continue past the start of closed paths so the cut meets cleanly"
msgstr "Prolonge la coupe au-delà du début des chemins fermés pour qu’elle se referme proprement"

#: extension/cutscape_cut.inx
msgid "Blade offset (mm):"
msgstr "Décalage de lame (mm) :"

#: extension/cutscape_cut.inx
msgid "Drag-knife tip offset; typically 0.25 for a 45° blade, 0.5 for 60°. Leave at 0 if the cutter compensates itself"
msgstr "Décalage de la pointe de la lame traînante ; en général 0,25 pour une lame à 45°, 0,5 pour 60°. Laisser à 0 si la découpeuse le compense elle-même"

#: extension/cutscape_cut.inx
msgid "Swivel above (°):"
msgstr "Pivoter au-delà de (°) :"

#: extension/cutscape_cut.inx
msgid "Corners sharper than this get a swivel arc when blade offset is on"
msgstr "Les angles plus aigus reçoivent un arc de pivotement quand le décalage de lame est actif"

#: extension/cutscape_cut.inx
msgid "Order:"
msgstr "Ordre :"

#: extension/cutscape_cut.inx
msgid "Inside shapes first, shortest travel"
msgstr "Formes intérieures d’abord, trajet le plus court"

#: extension/cutscape_cut.inx
msgid "Shortest travel"
msgstr "Trajet le plus court"

#: extension/cutscape_cut.inx
msgid "As drawn"
msgstr "Ordre du dessin"

#: extension/cutscape_cut.inx
msgid "Curve tolerance (mm):"
msgstr "Tolérance des courbes (mm) :"

#: extension/cutscape_cut.inx
msgid "Largest distance a cut may stray from a curve"
msgstr "Écart maximal entre la coupe et la courbe"

#: extension/cutscape_cut.inx
#: extension/cutscape/preview.py:64
msgid "Material"
msgstr "Matériau"

#: extension/cutscape_cut.inx
msgid "x runs across the material, y along the feed."
msgstr "x traverse le matériau, y suit le sens d’avance."

#: extension/cutscape_cut.inx
msgid "Width (mm):"
msgstr "Largeur (mm) :"

#: extension/cutscape_cut.inx
msgid "0 uses the device's width"
msgstr "0 utilise la largeur de la machine"

#: extension/cutscape_cut.inx
msgid "Length (mm):"
msgstr "Longueur (mm) :"

#: extension/cutscape_cut.inx
msgid "0 for a roll"
msgstr "0 pour un rouleau"

#: extension/cutscape_cut.inx
msgid "Move the job to the origin"
msgstr "Placer le travail à l’origine"

#: extension/cutscape_cut.inx
msgid "Otherwise it keeps its place relative to the page's bottom-left corner"
msgstr "Sinon, il garde sa position par rapport au coin inférieur gauche de la page"

#: extension/cutscape_cut.inx
msgid "Margin x (mm):"
msgstr "Marge x (mm) :"

#: extension/cutscape_cut.inx
msgid "Margin y (mm):"
msgstr "Marge y (mm) :"

#: extension/cutscape_cut.inx
msgid "Rotate 90°"
msgstr "Pivoter de 90°"

#: extension/cutscape_cut.inx
msgid "Mirror (heat transfer vinyl)"
msgstr "Miroir (flex thermocollant)"

#: extension/cutscape_cut.inx
msgid "Copies:"
msgstr "Copies :"

#: extension/cutscape_cut.inx
msgid "Spacing between copies (mm):"
msgstr "Espacement entre les copies (mm) :"

#: extension/cutscape_cut.inx
msgid "Weed line around the job"
msgstr "Ligne d’échenillage autour du travail"

#: extension/cutscape_cut.inx
msgid "Weed line padding (mm):"
msgstr "Marge de la ligne d’échenillage (mm) :"

#: extension/cutscape_cut.inx
msgid "Pre-feed the job's length first"
msgstr "Dérouler d’abord la longueur du travail"

#: extension/cutscape_cut.inx
msgid "Pull the material through and back before cutting so a roll tracks straight"
msgstr "Fait avancer puis reculer le matériau avant la découpe pour qu’un rouleau reste bien droit"

#: extension/cutscape_cut.inx
msgid "Feed past the job afterwards (mm):"
msgstr "Avancer après le travail (mm) :"

#: extension/cutscape_cut.inx
msgid "0 returns the head to the origin"
msgstr "0 ramène la tête à l’origine"

#: extension/cutscape_cut.inx
msgid "Device"
msgstr "Machine"

#: extension/cutscape_cut.inx
msgid "Cutter:"
msgstr "Découpeuse :"

#: extension/cutscape_cut.inx
msgid "Custom (settings below)"
msgstr "Personnalisée (réglages ci-dessous)"

#: extension/cutscape_cut.inx
msgid "With a cutter chosen, only Tool and the HPGL options below apply."
msgstr "Avec une découpeuse choisie, seuls l’outil et les options HPGL ci-dessous s’appliquent."

#: extension/cutscape_cut.inx
msgid "Language:"
msgstr "Langage :"

#: extension/cutscape_cut.inx
msgid "DMPL dialect:"
msgstr "Dialecte DMPL :"

#: extension/cutscape_cut.inx
msgid "Steps per mm, x:"
msgstr "Pas par mm, x :"

#: extension/cutscape_cut.inx
msgid "0 uses the language's default: 40 for HPGL/DMPL, 20 for GP-GL"
msgstr "0 utilise la valeur par défaut du langage : 40 pour HPGL/DMPL, 20 pour GP-GL"

#: extension/cutscape_cut.inx
msgid "Steps per mm, y:"
msgstr "Pas par mm, y :"

#: extension/cutscape_cut.inx
msgid "0 uses the same as x"
msgstr "0 reprend la valeur de x"

#: extension/cutscape_cut.inx
msgid "Swap axes"
msgstr "Permuter les axes"

#: extension/cutscape_cut.inx
msgid "Invert x"
msgstr "Inverser x"

#: extension/cutscape_cut.inx
msgid "Invert y"
msgstr "Inverser y"

#: extension/cutscape_cut.inx
msgid "Tool:"
msgstr "Outil :"

#: extension/cutscape_cut.inx
msgid "Pen or tool number; 0 sends none"
msgstr "Numéro de stylo ou d’outil ; 0 n’en envoie aucun"

#: extension/cutscape_cut.inx
msgid "HPGL: newline after each command"
msgstr "HPGL : saut de ligne après chaque commande"

#: extension/cutscape_cut.inx
msgid "HPGL: separate pen up/down from moves"
msgstr "HPGL : séparer la levée/descente de l’outil des déplacements"

#: extension/cutscape_cut.inx
msgid "Connection"
msgstr "Connexion"

#: extension/cutscape_cut.inx
msgid "Send through:"
msgstr "Envoyer via :"

#: extension/cutscape_cut.inx
msgid "Printer queue (CUPS or Windows)"
msgstr "File d’impression (CUPS ou Windows)"

#: extension/cutscape_cut.inx
msgid "Device file"
msgstr "Fichier de périphérique"

#: extension/cutscape_cut.inx
msgid "Serial port"
msgstr "Port série"

#: extension/cutscape_cut.inx
msgid "File"
msgstr "Fichier"

#: extension/cutscape_cut.inx
msgid "Printer queue:"
msgstr "File d’impression :"

#: extension/cutscape_cut.inx
msgid "A raw queue; leave empty to list the available ones. Managing the queue uses cutter when this is empty"
msgstr "Une file brute (raw) ; laisser vide pour lister celles disponibles. La gestion de la file utilise « cutter » si ce champ est vide"

#: extension/cutscape_cut.inx
msgid "Manage the queue:"
msgstr "Gérer la file :"

#: extension/cutscape_cut.inx
msgid "Done when Apply will is set to Manage the printer queue"
msgstr "Effectué quand le bouton Appliquer « gère la file d’impression »"

#: extension/cutscape_cut.inx
msgid "Create it for the USB cutter"
msgstr "La créer pour la découpeuse USB"

#: extension/cutscape_cut.inx
msgid "Restart it and clear stuck jobs"
msgstr "La redémarrer et vider les travaux bloqués"

#: extension/cutscape_cut.inx
msgid "Remove it"
msgstr "La supprimer"

#: extension/cutscape_cut.inx
msgid "Cutter's USB address:"
msgstr "Adresse USB de la découpeuse :"

#: extension/cutscape_cut.inx
msgid "Only needed to create a queue when more than one USB printer has none. Find connected cutters lists the addresses (usb://…)"
msgstr "Utile seulement pour créer une file quand plusieurs imprimantes USB n’en ont pas. « recherche les découpeuses connectées » liste les adresses (usb://…)"

#: extension/cutscape_cut.inx
msgid "Device file:"
msgstr "Fichier de périphérique :"

#: extension/cutscape_cut.inx
msgid "eg /dev/usb/lp0 or /dev/cutter on Linux, or a USB id such as usb:0483:5750 that keeps working when the number changes. Find connected cutters lists them"
msgstr "par ex. /dev/usb/lp0 ou /dev/cutter sous Linux, ou un identifiant USB comme usb:0483:5750, qui reste valable quand le numéro change. « Recherche les découpeuses connectées » les liste"

#: extension/cutscape_cut.inx
msgid "Serial port:"
msgstr "Port série :"

#: extension/cutscape_cut.inx
msgid "eg /dev/ttyUSB0, /dev/cu.usbserial-…, COM3, or a USB id such as usb:1a86:7523"
msgstr "par ex. /dev/ttyUSB0, /dev/cu.usbserial-…, COM3, ou un identifiant USB comme usb:1a86:7523"

#: extension/cutscape_cut.inx
msgid "Baud rate:"
msgstr "Débit (bauds) :"

#: extension/cutscape_cut.inx
msgid "Flow control:"
msgstr "Contrôle de flux :"

#: extension/cutscape_cut.inx
msgid "Software (XON/XOFF)"
msgstr "Logiciel (XON/XOFF)"

#: extension/cutscape_cut.inx
msgid "Hardware (RTS/CTS)"
msgstr "Matériel (RTS/CTS)"

#: extension/cutscape_cut.inx
msgid "Hardware (DSR/DTR)"
msgstr "Matériel (DSR/DTR)"

#: extension/cutscape_cut.inx
msgid "None"
msgstr "Aucun"

#: extension/cutscape_cut.inx
msgid "File:"
msgstr "Fichier :"

#: extension/cutscape_cut.inx
msgid "Preview or cut the selection on a vinyl cutter or plotter"
msgstr "Prévisualiser ou découper la sélection sur une découpeuse vinyle ou un traceur"

#: extension/cutscape_cut.inx
msgid "CutScape"
msgstr "CutScape"

#: extension/cutscape_cut.py:85
#, python-brace-format
msgid "Sent {width:.0f} × {height:.0f} mm, {metres:.2f} m of cuts ({size} bytes) to {where}."
msgstr "{width:.0f} × {height:.0f} mm envoyés, soit {metres:.2f} m de découpe ({size} octets), vers {where}."

#: extension/cutscape_cut.py:79
#, python-brace-format
msgid "Sent a {size:.0f} mm test square to {where}. Measure it: if it isn't {size:.0f} mm, the cutter's steps per mm are wrong."
msgstr "Carré test de {size:.0f} mm envoyé à {where}. Mesurez-le : s’il ne fait pas {size:.0f} mm, le nombre de pas par mm de la découpeuse est faux."

#: extension/cutscape/document.py:106
msgid "None of the selected objects can be cut"
msgstr "Aucun des objets sélectionnés ne peut être découpé"

#: extension/cutscape/document.py:145
#, python-brace-format
msgid "Can't convert text {id} to a path; convert it with Path > Object to Path"
msgstr "Impossible de convertir le texte {id} en chemin ; utilisez Chemin > Objet en chemin"

#: extension/cutscape/document.py:168
#, python-brace-format
msgid "Text {id} must be converted to a path first"
msgstr "Le texte {id} doit d’abord être converti en chemin"

#: extension/cutscape/job.py:156
msgid "Nothing to cut"
msgstr "Rien à découper"

#: extension/cutscape/job.py:118
#, python-brace-format
msgid "The job extends {distance:.1f} mm past the origin; move it onto the page or turn on \"Move the job to the origin\"."
msgstr "Le travail dépasse l’origine de {distance:.1f} mm ; placez-le sur la page ou activez « Placer le travail à l’origine »."

#: extension/cutscape/job.py:124
#, python-brace-format
msgid "The job is {size:.1f} mm wide but the material is only {limit:.1f} mm."
msgstr "Le travail fait {size:.1f} mm de large mais le matériau ne fait que {limit:.1f} mm."

#: extension/cutscape/job.py:127
#, python-brace-format
msgid "The job is {size:.1f} mm long but the material is only {limit:.1f} mm."
msgstr "Le travail fait {size:.1f} mm de long mais le matériau ne fait que {limit:.1f} mm."

#: extension/cutscape/preview.py:85
msgid "Origin"
msgstr "Origine"

#: extension/cutscape/preview.py:47
msgid "CutScape preview"
msgstr "Aperçu CutScape"

#: extension/cutscape/preview.py:76
msgid "Travel"
msgstr "Déplacements"

#: extension/cutscape/preview.py:80
msgid "Cuts"
msgstr "Découpes"

#: extension/cutscape/printers.py:88
msgid "No USB cutter without a printer queue was found. Check that it is plugged in and switched on, or enter its address (usb://…) in the Cutter's USB address field."
msgstr "Aucune découpeuse USB sans file d’impression n’a été trouvée. Vérifiez qu’elle est branchée et allumée, ou saisissez son adresse (usb://…) dans le champ « Adresse USB de la découpeuse »."

#: extension/cutscape/printers.py:128
#, python-brace-format
msgid "Created the printer queue {queue} for {uri}. On the Connection tab, choose Printer queue and enter {queue}."
msgstr "File d’impression {queue} créée pour {uri}. Dans l’onglet Connexion, choisissez « File d’impression » et saisissez {queue}."

#: extension/cutscape/printers.py:156
#, python-brace-format
msgid "Restarted the printer queue {queue}."
msgstr "File d’impression {queue} redémarrée."

#: extension/cutscape/printers.py:163
#, python-brace-format
msgid "Removed the printer queue {queue}."
msgstr "File d’impression {queue} supprimée."

#: extension/cutscape/printers.py:169
msgid "On Windows, add or remove printers in Settings > Printers & scanners."
msgstr "Sous Windows, ajoutez ou supprimez les imprimantes dans Paramètres > Imprimantes et scanners."

#: extension/cutscape/printers.py:59
#, python-brace-format
msgid ""
"CUPS won't let this account change printers. Run this in a terminal instead:\n"
"  sudo {command}"
msgstr ""
"CUPS n’autorise pas ce compte à modifier les imprimantes. Lancez plutôt ceci dans un terminal :\n"
"  sudo {command}"

#: extension/cutscape/printers.py:63
msgid "Or allow it for good: sudo usermod -aG lpadmin $USER, then log out and back in."
msgstr "Ou autorisez-le définitivement : sudo usermod -aG lpadmin $USER, puis déconnectez-vous et reconnectez-vous."

#: extension/cutscape/printers.py:67
#, python-brace-format
msgid "{command} failed: {error}"
msgstr "{command} a échoué : {error}"

#: extension/cutscape/printers.py:115
#, python-brace-format
msgid "The printer queue {queue} is already set up for {uri}."
msgstr "La file d’impression {queue} est déjà configurée pour {uri}."

#: extension/cutscape/printers.py:118
msgid "It is stopped; choose Restart it and clear stuck jobs to start it."
msgstr "Elle est arrêtée ; choisissez « La redémarrer et vider les travaux bloqués » pour la démarrer."

#: extension/cutscape/printers.py:126
#, python-brace-format
msgid "Moved the printer queue {queue} to {uri}."
msgstr "File d’impression {queue} déplacée vers {uri}."

#: extension/cutscape/printers.py:154
#, python-brace-format
msgid "Restarted the printer queue {queue} and cleared {count} waiting job(s)."
msgstr "File d’impression {queue} redémarrée ; travaux en attente supprimés : {count}."

#: extension/cutscape/printers.py:74
#, python-brace-format
msgid "A printer queue name may only use letters, digits, '.', '-' and '_'; got {queue}"
msgstr "Un nom de file d’impression ne peut contenir que des lettres, des chiffres, « . », « - » et « _ » ; reçu : {queue}"

#: extension/cutscape/printers.py:93
#, python-brace-format
msgid ""
"More than one USB printer has no queue. Enter the cutter's address in the Cutter's USB address field:\n"
"{uris}"
msgstr ""
"Plusieurs imprimantes USB n’ont pas de file. Saisissez l’adresse de la découpeuse dans le champ « Adresse USB de la découpeuse » :\n"
"{uris}"

#: extension/cutscape/printers.py:135
#, python-brace-format
msgid "There is no printer queue called {queue}."
msgstr "Il n’y a pas de file d’impression nommée {queue}."

#: extension/cutscape/printers.py:38
#, python-brace-format
msgid "Could not run {command}: {error}"
msgstr "Impossible de lancer {command} : {error}"

#: extension/cutscape/printers.py:41
#, python-brace-format
msgid "{command} did not answer; is CUPS running?"
msgstr "{command} ne répond pas ; CUPS est-il lancé ?"

#: extension/cutscape/transports.py:460
msgid "No cutters found. Check that it is plugged in and switched on. On Linux, serial ports need pyserial: sudo apt install python3-serial."
msgstr "Aucune découpeuse trouvée. Vérifiez qu’elle est branchée et allumée. Sous Linux, les ports série nécessitent pyserial : sudo apt install python3-serial."

#: extension/cutscape/transports.py:35
msgid "No output file set"
msgstr "Aucun fichier de sortie défini"

#: extension/cutscape/transports.py:154
msgid "No serial port set"
msgstr "Aucun port série défini"

#: extension/cutscape/transports.py:203
#, python-brace-format
msgid "{where} stopped accepting data for {seconds:.0f} s. Is the cutter online, with material loaded? Check its panel."
msgstr "{where} n’accepte plus de données depuis {seconds:.0f} s. La découpeuse est-elle en ligne, avec le support chargé ? Vérifiez son panneau."

#: extension/cutscape/transports.py:237
msgid "No device file set"
msgstr "Aucun fichier de périphérique défini"

#: extension/cutscape/transports.py:287
#, python-brace-format
msgid "Could not write to {path}: {error}"
msgstr "Impossible d’écrire sur {path} : {error}"

#: extension/cutscape/transports.py:419
msgid "USB cutters (choose Device file):"
msgstr "Découpeuses USB (choisissez Fichier de périphérique) :"

#: extension/cutscape/transports.py:435
msgid "Printer queues (choose Printer queue):"
msgstr "Files d’impression (choisissez File d’impression) :"

#: extension/cutscape/transports.py:445
msgid "USB printers with no queue yet. To make one, choose Manage the printer queue, then Create (enter the address if there are several), or run:"
msgstr "Imprimantes USB encore sans file. Pour en créer une, choisissez « gère la file d’impression » puis « La créer » (saisissez l’adresse s’il y en a plusieurs), ou lancez :"

#: extension/cutscape/transports.py:454
msgid "Serial ports (choose Serial port):"
msgstr "Ports série (choisissez Port série) :"

#: extension/cutscape/transports.py:124
msgid "Printing on Windows needs pywin32"
msgstr "L’impression sous Windows nécessite pywin32"

#: extension/cutscape/transports.py:152
msgid "Serial output needs pyserial (python3-serial on Linux)"
msgstr "La sortie série nécessite pyserial (python3-serial sous Linux)"

#: extension/cutscape/transports.py:280
#, python-brace-format
msgid "No permission to write to {path}. Add a udev rule for the cutter (choose \"Find connected cutters\" for one), or join the lp group: sudo usermod -aG lp $USER, then log out and back in."
msgstr "Pas le droit d’écrire sur {path}. Ajoutez une règle udev pour la découpeuse (« Recherche les découpeuses connectées » en propose une), ou rejoignez le groupe lp : sudo usermod -aG lp $USER, puis déconnectez-vous et reconnectez-vous."

#: extension/cutscape/transports.py:285
#, python-brace-format
msgid "{path} isn't there. Is the cutter plugged in and switched on?"
msgstr "{path} est introuvable. La découpeuse est-elle branchée et allumée ?"

#: extension/cutscape/transports.py:98
#, python-brace-format
msgid "No printer queue set. Available queues: {queues}"
msgstr "Aucune file d’impression définie. Files disponibles : {queues}"

#: extension/cutscape/transports.py:102
#, python-brace-format
msgid "The printer queue {queue} is stopped, so the job would wait in it. Choose Manage the printer queue, then Restart it and clear stuck jobs, or run: cupsenable {queue}"
msgstr "La file d’impression {queue} est arrêtée, le travail y resterait en attente. Choisissez « gère la file d’impression » puis « La redémarrer et vider les travaux bloqués », ou lancez : cupsenable {queue}"

#: extension/cutscape/transports.py:113
#, python-brace-format
msgid "lp failed ({code}): {error}"
msgstr "lp a échoué ({code}) : {error}"

#: extension/cutscape/transports.py:343
#, python-brace-format
msgid "A USB id looks like usb:0483:5750, optionally followed by :SERIAL; got {path}"
msgstr "Un identifiant USB a la forme usb:0483:5750, éventuellement suivi de :NUMÉRO_DE_SÉRIE ; reçu {path}"

#: extension/cutscape/transports.py:352
#, python-brace-format
msgid "No USB printer {path} is connected. Is the cutter plugged in and switched on?"
msgstr "Aucune imprimante USB {path} n’est connectée. La découpeuse est-elle branchée et allumée ?"

#: extension/cutscape/transports.py:356
#, python-brace-format
msgid "More than one USB printer matches {path}: {paths}. Add the serial number to tell them apart."
msgstr "Plusieurs imprimantes USB correspondent à {path} : {paths}. Ajoutez le numéro de série pour les distinguer."

#: extension/cutscape/transports.py:392
#, python-brace-format
msgid "No single serial port matches {port}; found {count}."
msgstr "Aucun port série unique ne correspond à {port} ; {count} trouvé(s)."

#: extension/cutscape/transports.py:438
msgid "(stopped: choose Manage the printer queue, then Restart)"
msgstr "(arrêtée : choisissez « gère la file d’impression » puis « La redémarrer »)"

#: extension/cutscape/transports.py:99
msgid "none found"
msgstr "aucune"

#: extension/cutscape/transports.py:111
#, python-brace-format
msgid "Could not run lp: {error}"
msgstr "Impossible de lancer lp : {error}"

#: extension/cutscape/transports.py:170
#, python-brace-format
msgid "Serial port {port}: {error}"
msgstr "Port série {port} : {error}"

#: extension/cutscape/transports.py:424
msgid "You can't write to it yet. To fix that for everyone who logs in, and to always find it at /dev/cutter, save this line as /etc/udev/rules.d/70-cutter.rules:"
msgstr "Vous ne pouvez pas encore y écrire. Pour corriger cela pour toute personne connectée, et la trouver toujours en /dev/cutter, enregistrez cette ligne dans /etc/udev/rules.d/70-cutter.rules :"

#: extension/cutscape/transports.py:429
msgid "then run: sudo udevadm control --reload && sudo udevadm trigger"
msgstr "puis lancez : sudo udevadm control --reload && sudo udevadm trigger"

#: extension/cutscape/transports.py:218
#, python-brace-format
msgid "No reply to {command} within {seconds} s"
msgstr "Pas de réponse à {command} en {seconds} s"

#: extension/cutscape/transports.py:267
#, python-brace-format
msgid "{sent} of {total} bytes were sent."
msgstr "{sent} octets sur {total} ont été envoyés."

