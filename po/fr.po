msgid "Or allow it for good: sudo usermod -aG lpadmin $USER, then log out and back in."
msgstr "Ou autorisez-le définitivement : sudo usermod -aG lpadmin $USER, puis déconnectez-vous et reconnectez-vous."

#: extension/cutscape/printers.py:71
msgid "CutScape needs to change the printer queue for your cutter."
msgstr "CutScape doit modifier la file d’impression de votre découpeuse."

#: extension/cutscape/printers.py:92
#, python-brace-format
msgid "A printer queue name may only use letters, digits, '.', '-' and '_'; got {queue}"
msgstr "Un nom de file d’impression ne peut contenir que des lettres, des chiffres, « . », « - » et « _ » ; reçu : {queue}"

