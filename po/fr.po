msgid ""
msgstr ""
"Project-Id-Version: CutScape\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: fr\n"
"Plural-Forms: nplurals=2; plural=(n > 1);\n"

#: extension/cutscape_add.inx
msgid "Add Cutter"
msgstr "Ajouter une découpeuse"

#: extension/cutscape_add.inx
msgid "Plug the cutter in and switch it on, choose its model, and click Apply. CutScape finds the cutter and sets up the connection. From then on, Cut sends to it."
msgstr "Branchez la découpeuse et allumez-la, choisissez son modèle, puis cliquez sur Appliquer. CutScape trouve la découpeuse et configure la connexion. Ensuite, Découpe lui envoie les travaux."

#: extension/cutscape_add.inx
msgid "Model:"
msgstr "Modèle :"

#: extension/cutscape_add.inx
msgid "Not listed (set it up on Cut's Device tab)"
msgstr "Absent de la liste (à régler dans l’onglet Machine de Découpe)"

#: extension/cutscape_add.inx
msgid "Address (optional):"
msgstr "Adresse (facultative) :"

#: extension/cutscape_add.inx
msgid "Leave empty and CutScape finds the cutter. If it finds more than one, it lists their addresses to enter here. The name of a printer queue, a device file or a serial port also works"
msgstr "Laissez vide et CutScape trouve la découpeuse. S’il en trouve plusieurs, il liste leurs adresses à saisir ici. Le nom d’une file d’impression, un fichier de périphérique ou un port série conviennent aussi"

#: extension/cutscape_add.inx
msgid "If the connection needs an administrator to set it up, the system asks for the password itself."
msgstr "Si la connexion doit être configurée par un administrateur, le système demande lui-même le mot de passe."

#: extension/cutscape_add.inx
msgid "Find the cutter that is plugged in and set it up for Cut"
msgstr "Trouver la découpeuse branchée et la configurer pour Découpe"

#: extension/cutscape_add.inx
#: extension/cutscape_clear.inx
#: extension/cutscape_cut.inx
#: extension/cutscape_marks.inx
#: extension/cutscape_remove.inx
msgid "CutScape"
msgstr "CutScape"

#: extension/cutscape_clear.inx
msgid "Remove Preview"
msgstr "Supprimer l’aperçu"

#: extension/cutscape_clear.inx
msgid "Remove the CutScape toolpath preview from the drawing"
msgstr "Supprimer du dessin l’aperçu du tracé de coupe CutScape"

#: extension/cutscape_cut.inx
#: extension/cutscape_cut.inx
#: extension/cutscape/align_window.py:198
msgid "Cut"
msgstr "Découpe"

#: extension/cutscape_cut.inx
msgid "Apply will:"
msgstr "Le bouton Appliquer :"

#: extension/cutscape_cut.inx
msgid "Preview the toolpath on the canvas"
msgstr "prévisualise le tracé de coupe sur le canevas"

#: extension/cutscape_cut.inx
msgid "Send to the cutter"
msgstr "envoie à la découpeuse"

#: extension/cutscape_cut.inx
msgid "Send a 50 mm test square"
msgstr "envoie un carré test de 50 mm"

#: extension/cutscape_cut.inx
msgid "Line up with printed crop marks and cut"
msgstr "aligne sur les repères imprimés et découpe"

#: extension/cutscape_cut.inx
msgid "Calibrate the laser for lining up"
msgstr "calibre le laser pour l’alignement"

#: extension/cutscape_cut.inx
msgid "Cuts the selection, or the whole drawing if nothing is selected."
msgstr "Découpe la sélection, ou tout le dessin si rien n’est sélectionné."

#: extension/cutscape_cut.inx
msgid "Speed (cm/s):"
msgstr "Vitesse (cm/s) :"

#: extension/cutscape_cut.inx
#: extension/cutscape_cut.inx
msgid "0 leaves the cutter's own setting"
msgstr "0 conserve le réglage de la découpeuse"

#: extension/cutscape_cut.inx
msgid "Force (g):"
msgstr "Pression (g) :"

#: extension/cutscape_cut.inx
msgid "Passes:"
msgstr "Passages :"

#: extension/cutscape_cut.inx
msgid "Cut each path this many times; closed paths are cut as one continuous loop"
msgstr "Découpe chaque chemin ce nombre de fois ; les chemins fermés sont découpés en une seule boucle continue"

#: extension/cutscape_cut.inx
msgid "Overcut (mm):"
msgstr "Surcoupe (mm) :"

#: extension/cutscape_cut.inx
msgid "Continue past the start of closed paths so the cut meets cleanly"
msgstr "Prolonge la coupe au-delà du début des chemins fermés pour qu’elle se referme proprement"

#: extension/cutscape_cut.inx
msgid "Blade offset (mm):"
msgstr "Décalage de lame (mm) :"

#: extension/cutscape_cut.inx
msgid "Drag-knife tip offset; typically 0.25 for a 45° blade, 0.5 for 60°. Leave at 0 if the cutter compensates itself"
msgstr "Décalage de la pointe de la lame traînante ; en général 0,25 pour une lame à 45°, 0,5 pour 60°. Laisser à 0 si la découpeuse le compense elle-même"

#: extension/cutscape_cut.inx
msgid "Swivel above (°):"
msgstr "Pivoter au-delà de (°) :"

#: extension/cutscape_cut.inx
msgid "Corners sharper than this get a swivel arc when blade offset is on"
msgstr "Les angles plus aigus reçoivent un arc de pivotement quand le décalage de lame est actif"

#: extension/cutscape_cut.inx
msgid "Order:"
msgstr "Ordre :"

#: extension/cutscape_cut.inx
msgid "Inside shapes first, shortest travel"
msgstr "Formes intérieures d’abord, trajet le plus court"

#: extension/cutscape_cut.inx
msgid "Shortest travel"
msgstr "Trajet le plus court"

#: extension/cutscape_cut.inx
msgid "As drawn"
msgstr "Ordre du dessin"

#: extension/cutscape_cut.inx
msgid "Curve tolerance (mm):"
msgstr "Tolérance des courbes (mm) :"

#: extension/cutscape_cut.inx
msgid "Largest distance a cut may stray from a curve"
msgstr "Écart maximal entre la coupe et la courbe"

#: extension/cutscape_cut.inx
#: extension/cutscape/preview.py:64
msgid "Material"
msgstr "Matériau"

#: extension/cutscape_cut.inx
msgid "x runs across the material, y along the feed."
msgstr "x traverse le matériau, y suit le sens d’avance."

#: extension/cutscape_cut.inx
msgid "Width (mm):"
msgstr "Largeur (mm) :"

#: extension/cutscape_cut.inx
msgid "0 uses the device's width"
msgstr "0 utilise la largeur de la machine"

#: extension/cutscape_cut.inx
msgid "Length (mm):"
msgstr "Longueur (mm) :"

#: extension/cutscape_cut.inx
msgid "0 for a roll"
msgstr "0 pour un rouleau"

#: extension/cutscape_cut.inx
msgid "Move the job to the origin"
msgstr "Placer le travail à l’origine"

#: extension/cutscape_cut.inx
msgid "Otherwise it keeps its place relative to the page's bottom-left corner"
msgstr "Sinon, il garde sa position par rapport au coin inférieur gauche de la page"

#: extension/cutscape_cut.inx
msgid "Margin x (mm):"
msgstr "Marge x (mm) :"

#: extension/cutscape_cut.inx
msgid "Margin y (mm):"
msgstr "Marge y (mm) :"

#: extension/cutscape_cut.inx
msgid "Rotate 90°"
msgstr "Pivoter de 90°"

#: extension/cutscape_cut.inx
msgid "Mirror (heat transfer vinyl)"
msgstr "Miroir (flex thermocollant)"

#: extension/cutscape_cut.inx
msgid "Copies:"
msgstr "Copies :"

#: extension/cutscape_cut.inx
msgid "Spacing between copies (mm):"
msgstr "Espacement entre les copies (mm) :"

#: extension/cutscape_cut.inx
msgid "Weed line around the job"
msgstr "Ligne d’échenillage autour du travail"

#: extension/cutscape_cut.inx
msgid "Weed line padding (mm):"
msgstr "Marge de la ligne d’échenillage (mm) :"

#: extension/cutscape_cut.inx
msgid "Pre-feed the job's length first"
msgstr "Dérouler d’abord la longueur du travail"

#: extension/cutscape_cut.inx
msgid "Pull the material through and back before cutting so a roll tracks straight"
msgstr "Fait avancer puis reculer le matériau avant la découpe pour qu’un rouleau reste bien droit"

#: extension/cutscape_cut.inx
msgid "Feed past the job afterwards (mm):"
msgstr "Avancer après le travail (mm) :"

#: extension/cutscape_cut.inx
msgid "0 returns the head to the origin"
msgstr "0 ramène la tête à l’origine"

#: extension/cutscape_cut.inx
msgid "Device"
msgstr "Machine"

#: extension/cutscape_cut.inx
msgid "Cutter:"
msgstr "Découpeuse :"

#: extension/cutscape_cut.inx
#: extension/cutscape_cut.inx
msgid "The cutter you added"
msgstr "La découpeuse ajoutée"

#: extension/cutscape_cut.inx
msgid "Custom (settings below)"
msgstr "Personnalisée (réglages ci-dessous)"

#: extension/cutscape_cut.inx
msgid "With a cutter chosen, only Tool and the HPGL and G-code options below apply."
msgstr "Avec une découpeuse choisie, seuls l’outil et les options HPGL et G-code ci-dessous s’appliquent."

#: extension/cutscape_cut.inx
msgid "Language:"
msgstr "Langage :"

#: extension/cutscape_cut.inx
msgid "DMPL dialect:"
msgstr "Dialecte DMPL :"

#: extension/cutscape_cut.inx
msgid "Steps per mm, x:"
msgstr "Pas par mm, x :"

#: extension/cutscape_cut.inx
msgid "0 uses the language's default: 40 for HPGL/DMPL, 20 for GP-GL"
msgstr "0 utilise la valeur par défaut du langage : 40 pour HPGL/DMPL, 20 pour GP-GL"

#: extension/cutscape_cut.inx
msgid "Steps per mm, y:"
msgstr "Pas par mm, y :"

#: extension/cutscape_cut.inx
msgid "0 uses the same as x"
msgstr "0 reprend la valeur de x"

#: extension/cutscape_cut.inx
msgid "Swap axes"
msgstr "Permuter les axes"

#: extension/cutscape_cut.inx
msgid "Invert x"
msgstr "Inverser x"

#: extension/cutscape_cut.inx
msgid "Invert y"
msgstr "Inverser y"

#: extension/cutscape_cut.inx
msgid "Tool:"
msgstr "Outil :"

#: extension/cutscape_cut.inx
msgid "Pen or tool number; 0 sends none"
msgstr "Numéro de stylo ou d’outil ; 0 n’en envoie aucun"

#: extension/cutscape_cut.inx
msgid "HPGL: newline after each command"
msgstr "HPGL : saut de ligne après chaque commande"

#: extension/cutscape_cut.inx
msgid "HPGL: separate pen up/down from moves"
msgstr "HPGL : séparer la levée/descente de l’outil des déplacements"

#: extension/cutscape_cut.inx
msgid "G-code: Z for travel (mm):"
msgstr "G-code : Z pour les déplacements (mm) :"

#: extension/cutscape_cut.inx
msgid "Height the tool lifts to between cuts"
msgstr "Hauteur à laquelle l’outil remonte entre les découpes"

#: extension/cutscape_cut.inx
msgid "G-code: Z for cutting (mm):"
msgstr "G-code : Z pour la découpe (mm) :"

#: extension/cutscape_cut.inx
msgid "Zero Z on the machine where the blade or pen should cut, and leave this at 0. Make both heights the same to send no Z moves."
msgstr "Faites le zéro Z de la machine là où la lame ou le stylo doit couper, et laissez 0 ici. Donnez la même valeur aux deux hauteurs pour n’envoyer aucun mouvement en Z."

#: extension/cutscape_cut.inx
msgid "Connection"
msgstr "Connexion"

#: extension/cutscape_cut.inx
msgid "Send through:"
msgstr "Envoyer via :"

#: extension/cutscape_cut.inx
msgid "Printer queue (CUPS or Windows)"
msgstr "File d’impression (CUPS ou Windows)"

#: extension/cutscape_cut.inx
msgid "Device file"
msgstr "Fichier de périphérique"

#: extension/cutscape_cut.inx
msgid "Serial port"
msgstr "Port série"

#: extension/cutscape_cut.inx
msgid "File"
msgstr "Fichier"

#: extension/cutscape_cut.inx
msgid "Printer queue:"
msgstr "File d’impression :"

#: extension/cutscape_cut.inx
msgid "A raw queue; leave empty to list the available ones"
msgstr "Une file brute ; laisser vide pour lister celles qui existent"

#: extension/cutscape_cut.inx
msgid "Device file:"
msgstr "Fichier de périphérique :"

#: extension/cutscape_cut.inx
msgid "eg /dev/usb/lp0 or /dev/cutter on Linux, or a USB id such as usb:0483:5750 that keeps working when the number changes"
msgstr "p. ex. /dev/usb/lp0 ou /dev/cutter sous Linux, ou un identifiant USB comme usb:0483:5750, qui reste valable quand le numéro change"

#: extension/cutscape_cut.inx
msgid "Serial port:"
msgstr "Port série :"

#: extension/cutscape_cut.inx
msgid "eg /dev/ttyUSB0, /dev/cu.usbserial-…, COM3, or a USB id such as usb:1a86:7523"
msgstr "par ex. /dev/ttyUSB0, /dev/cu.usbserial-…, COM3, ou un identifiant USB comme usb:1a86:7523"

#: extension/cutscape_cut.inx
msgid "Baud rate:"
msgstr "Débit (bauds) :"

#: extension/cutscape_cut.inx
msgid "Flow control:"
msgstr "Contrôle de flux :"

#: extension/cutscape_cut.inx
msgid "Software (XON/XOFF)"
msgstr "Logiciel (XON/XOFF)"

#: extension/cutscape_cut.inx
msgid "Hardware (RTS/CTS)"
msgstr "Matériel (RTS/CTS)"

#: extension/cutscape_cut.inx
msgid "Hardware (DSR/DTR)"
msgstr "Matériel (DSR/DTR)"

#: extension/cutscape_cut.inx
msgid "None"
msgstr "Aucun"

#: extension/cutscape_cut.inx
msgid "File:"
msgstr "Fichier :"

#: extension/cutscape_cut.inx
msgid "Preview or cut the selection on a vinyl cutter or plotter"
msgstr "Prévisualiser ou découper la sélection sur une découpeuse vinyle ou un traceur"

#: extension/cutscape_cut.py:131
msgid "Added four crop marks, and moved the lines to cut to a hidden layer so they don't print."
msgstr "Quatre repères de coupe ajoutés, et les lignes à découper déplacées sur un calque masqué pour qu’elles ne s’impriment pas."

#: extension/cutscape_cut.py:137
msgid "Next, print it at 100%, with no \"fit to page\". Put the sheet in the cutter and set the cutter's origin below and to the left of mark 1. Then open Extensions > CutScape > Cut, choose Line up with printed crop marks and cut, and click Apply."
msgstr "Ensuite, imprimez à 100 %, sans « ajuster à la page ». Placez la feuille dans la découpeuse et réglez son origine en bas à gauche du repère 1. Puis ouvrez Extensions > CutScape > Découpe, choisissez d’aligner sur les repères imprimés et de découper, et cliquez sur Appliquer."

#: extension/cutscape_cut.py:134
msgid "The marks don't all fit on the page, leaving room for the printer's margin. Make the page bigger or the design smaller, and add them again."
msgstr "Les repères ne tiennent pas tous sur la page, marge de l’imprimante comprise. Agrandissez la page ou réduisez le dessin, puis ajoutez-les à nouveau."

#: extension/cutscape_cut.py:115
#, python-brace-format
msgid "Sent {width:.0f} × {height:.0f} mm, {metres:.2f} m of cuts ({size} bytes) to {where}."
msgstr "{width:.0f} × {height:.0f} mm envoyés, soit {metres:.2f} m de découpe ({size} octets), vers {where}."

#: extension/cutscape_cut.py:164
#, python-brace-format
msgid "Sent {metres:.2f} m of cuts, lined up with the printed sheet, to {where}."
msgstr "{metres:.2f} m de découpe, alignés sur la feuille imprimée, envoyés à {where}."

#: extension/cutscape_cut.py:181
#, python-brace-format
msgid "Laser calibrated. It points {x:+.2f} mm along X and {y:+.2f} mm along Y from the blade, and CutScape will remember that."
msgstr "Laser calibré. Il pointe à {x:+.2f} mm en X et {y:+.2f} mm en Y de la lame, et CutScape s’en souviendra."

#: extension/cutscape_cut.py:109
#, python-brace-format
msgid "Sent a {size:.0f} mm test square to {where}. Measure it: if it isn't {size:.0f} mm, the cutter's steps per mm are wrong."
msgstr "Carré test de {size:.0f} mm envoyé à {where}. Mesurez-le : s’il ne fait pas {size:.0f} mm, le nombre de pas par mm de la découpeuse est faux."

#: extension/cutscape_marks.inx
msgid "Add Crop Marks"
msgstr "Ajouter des repères de coupe"

#: extension/cutscape_marks.inx
msgid "For print and cut: hide the selected lines so they don't print, and add crop marks to line the cut up with the printed sheet"
msgstr "Pour l’impression-découpe : masque les lignes sélectionnées pour qu’elles ne s’impriment pas, et ajoute des repères pour aligner la découpe sur la feuille imprimée"

#: extension/cutscape_remove.inx
msgid "Remove Cutter"
msgstr "Retirer la découpeuse"

#: extension/cutscape_remove.inx
msgid "Forgets the cutter you added, and removes the printer queue Add Cutter made for it. You can add it again at any time."
msgstr "Oublie la découpeuse ajoutée et supprime la file d’impression qu’Ajouter une découpeuse a créée pour elle. Vous pouvez l’ajouter de nouveau à tout moment."

#: extension/cutscape_remove.inx
msgid "Forget the cutter you added"
msgstr "Oublier la découpeuse ajoutée"

#: extension/cutscape/admin.py:68
msgid "The password prompt was cancelled."
msgstr "La demande de mot de passe a été annulée."

#: extension/cutscape/admin.py:61
msgid "Nobody answered the password prompt."
msgstr "Personne n’a répondu à la demande de mot de passe."

#: extension/cutscape/align.py:35
msgid "Lining up with printed marks isn't available for G-code machines yet."
msgstr "L’alignement sur des repères imprimés n’est pas encore disponible pour les machines G-code."

#: extension/cutscape/align.py:38
msgid "Lining up needs a direct connection to the cutter, to move the head as you click: its USB device on Linux (Add Cutter sets that up) or a serial port."
msgstr "L’alignement nécessite une connexion directe à la découpeuse, pour déplacer la tête à chaque clic : son périphérique USB sous Linux (Ajouter une découpeuse le configure) ou un port série."

#: extension/cutscape/align.py:81
msgid "Two crop marks are in the same place."
msgstr "Deux repères de coupe sont au même endroit."

#: extension/cutscape/align.py:97
msgid "The crop marks are in a line, so they don't show how the sheet lies."
msgstr "Les repères de coupe sont alignés et ne montrent donc pas la position de la feuille."

#: extension/cutscape/align.py:251
msgid "The sheet is stretched more than expected. Was it printed at 100%, with no \"fit to page\"?"
msgstr "La feuille est plus étirée que prévu. A-t-elle été imprimée à 100 %, sans « ajuster à la page » ?"

#: extension/cutscape/align.py:254
msgid "The marks don't agree with each other. Go back and check you aimed at each one, in the right order."
msgstr "Les repères ne concordent pas. Revenez en arrière et vérifiez que vous avez visé chacun d’eux, dans le bon ordre."

#: extension/cutscape/align.py:275
msgid "Move the laser onto the cross first: the head hasn't moved since cutting it."
msgstr "Placez d’abord le laser sur la croix : la tête n’a pas bougé depuis la découpe."

#: extension/cutscape/align.py:167
#, python-brace-format
msgid "Move the head at least {size:.0f} mm from the origin first."
msgstr "Éloignez d’abord la tête d’au moins {size:.0f} mm de l’origine."

#: extension/cutscape/align_window.py:84
msgid "If the head doesn't go the way the arrow points"
msgstr "Si la tête ne va pas dans le sens de la flèche"

#: extension/cutscape/align_window.py:210
msgid "Lining up needs CutScape's window, and GTK isn't available here."
msgstr "L’alignement a besoin de la fenêtre de CutScape, et GTK n’est pas disponible ici."

#: extension/cutscape/align_window.py:214
msgid "Line up with the printed sheet"
msgstr "Aligner sur la feuille imprimée"

#: extension/cutscape/align_window.py:75
msgid "Back"
msgstr "Retour"

#: extension/cutscape/align_window.py:78
msgid "Calibrate laser…"
msgstr "Calibrer le laser…"

#: extension/cutscape/align_window.py:82
msgid "Turn arrows"
msgstr "Tourner les flèches"

#: extension/cutscape/align_window.py:90
msgid "Cancel"
msgstr "Annuler"

#: extension/cutscape/align_window.py:117
msgid "That's as far as the cutter's origin. If the mark is further than that, move the origin back on the cutter's panel and start again."
msgstr "La tête est à l’origine de la découpeuse. Si le repère est plus loin, reculez l’origine sur le panneau de la découpeuse et recommencez."

#: extension/cutscape/align_window.py:172
msgid "Cut the cross"
msgstr "Découper la croix"

#: extension/cutscape/align_window.py:55
msgid "Each arrow moves:"
msgstr "Chaque flèche déplace de :"

#: extension/cutscape/align_window.py:156
#, python-brace-format
msgid "Head at X {x:.2f} mm, Y {y:.2f} mm"
msgstr "Tête à X {x:.2f} mm, Y {y:.2f} mm"

#: extension/cutscape/align_window.py:174
msgid "Move the laser onto the centre of the cross you just cut."
msgstr "Placez le laser sur le centre de la croix que vous venez de découper."

#: extension/cutscape/align_window.py:176
msgid "Laser is on the cross"
msgstr "Le laser est sur la croix"

#: extension/cutscape/align_window.py:192
#, python-brace-format
msgid "All four marks found. The sheet is turned {angle:.2f}° and stretched {x:+.2f}% and {y:+.2f}%; the marks agree to within {error:.2f} mm."
msgstr "Les quatre repères sont trouvés. La feuille est tournée de {angle:.2f}° et étirée de {x:+.2f} % et {y:+.2f} % ; les repères concordent à {error:.2f} mm près."

#: extension/cutscape/align_window.py:166
#, python-brace-format
msgid "Put scrap material in the cutter and move the head over it, at least {margin:.0f} mm from the origin. CutScape will cut a {size:.0f} mm cross there, so don't leave your printed sheet under it."
msgstr "Placez une chute dans la découpeuse et amenez la tête au-dessus, à au moins {margin:.0f} mm de l’origine. CutScape y découpera une croix de {size:.0f} mm : n’y laissez pas votre feuille imprimée."

#: extension/cutscape/align_window.py:182
#, python-brace-format
msgid "Move the laser onto crop mark {number} ({corner})."
msgstr "Placez le laser sur le repère {number} ({corner})."

#: extension/cutscape/align_window.py:184
#, python-brace-format
msgid "Move the blade tip onto crop mark {number} ({corner})."
msgstr "Placez la pointe de la lame sur le repère {number} ({corner})."

#: extension/cutscape/align_window.py:187
msgid "On the mark"
msgstr "Sur le repère"

#: extension/cutscape/cutter.py:403
msgid "cutter"
msgstr "découpeuse"

#: extension/cutscape/cutter.py:425
msgid "No cutter has been added."
msgstr "Aucune découpeuse n’a été ajoutée."

#: extension/cutscape/cutter.py:426
msgid "Removed the cutter you added."
msgstr "La découpeuse ajoutée a été retirée."

#: extension/cutscape/cutter.py:166
msgid "No cutter found. Check that it is plugged in and switched on, then try again."
msgstr "Aucune découpeuse trouvée. Vérifiez qu’elle est branchée et allumée, puis réessayez."

#: extension/cutscape/cutter.py:300
#, python-brace-format
msgid ""
"You can't write to {path} yet. To fix that, run this in a terminal, then unplug the cutter and plug it back in:\n"
"  {command}"
msgstr ""
"Vous ne pouvez pas encore écrire dans {path}. Pour y remédier, lancez ceci dans un terminal, puis débranchez la découpeuse et rebranchez-la :\n"
"  {command}"

#: extension/cutscape/cutter.py:333
msgid "Set its baud rate and flow control on Cut's Connection tab."
msgstr "Réglez son débit et son contrôle de flux dans l’onglet Connexion de Découpe."

#: extension/cutscape/cutter.py:366
#, python-brace-format
msgid "the printer queue {queue}"
msgstr "la file d’impression {queue}"

#: extension/cutscape/cutter.py:411
msgid "Set its language and steps per mm on Cut's Device tab."
msgstr "Réglez son langage et ses pas par mm dans l’onglet Machine de Découpe."

#: extension/cutscape/cutter.py:414
msgid "To check it, open Extensions > CutScape > Cut, choose Send a 50 mm test square and click Apply."
msgstr "Pour la vérifier, ouvrez Extensions > CutScape > Découpe et envoyez un carré test de 50 mm."

#: extension/cutscape/cutter.py:108
msgid "No cutter has been added yet. Plug it in and switch it on, then use Extensions > CutScape > Add Cutter. Or choose how to reach it on Cut's Connection tab."
msgstr "Aucune découpeuse n’a encore été ajoutée. Branchez-la et allumez-la, puis utilisez Extensions > CutScape > Ajouter une découpeuse. Ou choisissez comment la joindre dans l’onglet Connexion de Découpe."

#: extension/cutscape/cutter.py:169
msgid "CUPS wouldn't list USB printers for this account, so a cutter that needs a printer queue can't be found."
msgstr "CUPS refuse de lister les imprimantes USB pour ce compte : une découpeuse qui a besoin d’une file d’impression ne peut donc pas être trouvée."

#: extension/cutscape/cutter.py:177
msgid "A USB cutter must be added to Windows first: Settings > Bluetooth & devices > Printers & scanners, with the Generic / Text Only driver. Then enter the printer's name in the Address field."
msgstr "Une découpeuse USB doit d’abord être ajoutée à Windows : Paramètres > Bluetooth et appareils > Imprimantes et scanners, avec le pilote Generic / Text Only. Saisissez ensuite le nom de l’imprimante dans le champ Adresse."

#: extension/cutscape/cutter.py:191
msgid "Cutters on a serial port need pyserial: sudo apt install python3-serial"
msgstr "Les découpeuses sur port série ont besoin de pyserial : sudo apt install python3-serial"

#: extension/cutscape/cutter.py:289
msgid "CutScape needs to let you use your cutter."
msgstr "CutScape doit vous donner accès à votre découpeuse."

#: extension/cutscape/cutter.py:363
#, python-brace-format
msgid "USB, as {device}"
msgstr "USB, sous {device}"

#: extension/cutscape/cutter.py:365
#, python-brace-format
msgid "the serial port {port}"
msgstr "le port série {port}"

#: extension/cutscape/cutter.py:404
#, python-brace-format
msgid "Added your {model}, connected through {connection}."
msgstr "Votre {model} est ajoutée, connectée via {connection}."

#: extension/cutscape/cutter.py:173
msgid "To allow it: sudo usermod -aG lpadmin $USER, then log out and back in."
msgstr "Pour l’autoriser : sudo usermod -aG lpadmin $USER, puis déconnectez-vous et reconnectez-vous."

#: extension/cutscape/cutter.py:227
#, python-brace-format
msgid "CutScape doesn't know {address}. Enter the name of a printer queue, a usb://… address, a USB id such as usb:0483:5750, a device file or a serial port."
msgstr "CutScape ne connaît pas {address}. Saisissez le nom d’une file d’impression, une adresse usb://…, un identifiant USB comme usb:0483:5750, un fichier de périphérique ou un port série."

#: extension/cutscape/cutter.py:407
#, python-brace-format
msgid "It calls itself {device}."
msgstr "Elle se présente comme {device}."

#: extension/cutscape/cutter.py:434
#, python-brace-format
msgid "Removed its printer queue {queue}."
msgstr "Sa file d’impression {queue} a été supprimée."

#: extension/cutscape/cutter.py:187
msgid "If it is connected another way, enter one of these in the Address field:"
msgstr "Si elle est connectée autrement, saisissez l’une de ces adresses dans le champ Adresse :"

#: extension/cutscape/cutter.py:297
#, python-brace-format
msgid "Added a udev rule ({file}) to give you access. Unplug the cutter and plug it back in to apply it."
msgstr "Règle udev ajoutée ({file}) pour vous donner accès. Débranchez la découpeuse et rebranchez-la pour l’appliquer."

#: extension/cutscape/cutter.py:329
#, python-brace-format
msgid "It talks at {baud} baud."
msgstr "Elle communique à {baud} bauds."

#: extension/cutscape/cutter.py:350
#, python-brace-format
msgid "Its printer queue {queue} had stopped: restarted it and cleared {count} stuck job(s)."
msgstr "Sa file d’impression {queue} était arrêtée : elle a été relancée et {count} travail(aux) bloqué(s) effacé(s)."

#: extension/cutscape/cutter.py:352
#, python-brace-format
msgid "Its printer queue {queue} had stopped: restarted it."
msgstr "Sa file d’impression {queue} était arrêtée : elle a été relancée."

#: extension/cutscape/cutter.py:386
msgid "More than one possible cutter is connected. Enter the address of yours in the Address field and click Apply again:"
msgstr "Plusieurs découpeuses possibles sont connectées. Saisissez l’adresse de la vôtre dans le champ Adresse et cliquez de nouveau sur Appliquer :"

#: extension/cutscape/cutter.py:223
#: extension/cutscape/transports.py:295
#, python-brace-format
msgid "{path} isn't there. Is the cutter plugged in and switched on?"
msgstr "{path} est introuvable. La découpeuse est-elle branchée et allumée ?"

#: extension/cutscape/cutter.py:295
#, python-brace-format
msgid "Gave you access to it with a udev rule ({file})."
msgstr "Accès accordé avec une règle udev ({file})."

#: extension/cutscape/cutter.py:323
#, python-brace-format
msgid "You can't write to {path} yet."
msgstr "Vous ne pouvez pas encore écrire dans {path}."

#: extension/cutscape/cutter.py:341
#, python-brace-format
msgid "Pointed the printer queue {queue} at it."
msgstr "La file d’impression {queue} pointe désormais vers elle."

#: extension/cutscape/cutter.py:343
#, python-brace-format
msgid "Created the printer queue {queue} for it."
msgstr "File d’impression {queue} créée pour elle."

#: extension/cutscape/document.py:207
#: extension/cutscape/job.py:170
#: extension/cutscape/job.py:225
msgid "Nothing to cut"
msgstr "Rien à découper"

#: extension/cutscape/document.py:220
msgid "Select the lines to cut, then use Extensions > CutScape > Add Crop Marks."
msgstr "Sélectionnez les lignes à découper, puis utilisez Extensions > CutScape > Ajouter des repères de coupe."

#: extension/cutscape/document.py:114
msgid "None of the selected objects can be cut"
msgstr "Aucun des objets sélectionnés ne peut être découpé"

#: extension/cutscape/document.py:234
msgid "This drawing has no crop marks. Use Extensions > CutScape > Add Crop Marks and print it first."
msgstr "Ce dessin n’a pas de repères de coupe. Utilisez d’abord Extensions > CutScape > Ajouter des repères de coupe, puis imprimez-le."

#: extension/cutscape/document.py:153
#, python-brace-format
msgid "Can't convert text {id} to a path; convert it with Path > Object to Path"
msgstr "Impossible de convertir le texte {id} en chemin ; utilisez Chemin > Objet en chemin"

#: extension/cutscape/document.py:176
#, python-brace-format
msgid "Text {id} must be converted to a path first"
msgstr "Le texte {id} doit d’abord être converti en chemin"

#: extension/cutscape/job.py:134
msgid "Set a speed on the Cut tab: G-code controllers such as GRBL won't cut without one."
msgstr "Réglez une vitesse dans l’onglet Découpe : les contrôleurs G-code comme GRBL ne découpent pas sans."

#: extension/cutscape/job.py:125
#, python-brace-format
msgid "The cut reaches {distance:.1f} mm past the cutter's origin. Move the origin back on the cutter's panel and line up again."
msgstr "La découpe dépasse de {distance:.1f} mm l’origine de la découpeuse. Reculez l’origine sur le panneau de la découpeuse et alignez à nouveau."

#: extension/cutscape/job.py:138
#, python-brace-format
msgid "The job is {size:.1f} mm wide but the material is only {limit:.1f} mm."
msgstr "Le travail fait {size:.1f} mm de large mais le matériau ne fait que {limit:.1f} mm."

#: extension/cutscape/job.py:141
#, python-brace-format
msgid "The job is {size:.1f} mm long but the material is only {limit:.1f} mm."
msgstr "Le travail fait {size:.1f} mm de long mais le matériau ne fait que {limit:.1f} mm."

#: extension/cutscape/job.py:129
#, python-brace-format
msgid "The job extends {distance:.1f} mm past the origin; move it onto the page or turn on \"Move the job to the origin\"."
msgstr "Le travail dépasse l’origine de {distance:.1f} mm ; placez-le sur la page ou activez « Placer le travail à l’origine »."

