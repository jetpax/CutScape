msgstr "Aucun fichier de périphérique défini"

#: extension/cutscape/transports.py:297
#, python-brace-format
msgid "Could not write to {path}: {error}"
msgstr "Impossible d’écrire sur {path} : {error}"

#: extension/cutscape/transports.py:124
msgid "Printing on Windows needs pywin32"
msgstr "L’impression sous Windows nécessite pywin32"

#: extension/cutscape/transports.py:152
msgid "Serial output needs pyserial (python3-serial on Linux)"
msgstr "La sortie série nécessite pyserial (python3-serial sous Linux)"

#: extension/cutscape/transports.py:290
#, python-brace-format
msgid "No permission to write to {path}. Extensions > CutScape > Add Cutter fixes that with a udev rule; or join the lp group: sudo usermod -aG lp $USER, then log out and back in."
msgstr "Pas le droit d’écrire dans {path}. Extensions > CutScape > Ajouter une découpeuse corrige cela avec une règle udev ; ou rejoignez le groupe lp : sudo usermod -aG lp $USER, puis déconnectez-vous et reconnectez-vous."

#: extension/cutscape/transports.py:98
#, python-brace-format
msgid "No printer queue set. Available queues: {queues}"
msgstr "Aucune file d’impression définie. Files disponibles : {queues}"

#: extension/cutscape/transports.py:102
#, python-brace-format
msgid "The printer queue {queue} is stopped, so the job would wait in it. Run Extensions > CutScape > Add Cutter again to restart it and clear the stuck jobs, or run: cupsenable {queue}"
msgstr "La file d’impression {queue} est arrêtée : le travail y resterait en attente. Relancez Extensions > CutScape > Ajouter une découpeuse pour la redémarrer et effacer les travaux bloqués, ou lancez : cupsenable {queue}"

#: extension/cutscape/transports.py:113
#, python-brace-format
msgid "lp failed ({code}): {error}"
msgstr "lp a échoué ({code}) : {error}"

